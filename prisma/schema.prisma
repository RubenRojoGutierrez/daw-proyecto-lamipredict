generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id_usuario    Int      @id @default(autoincrement())
  nombre        String
  email         String   @unique
  password_hash String
  rol           String

  // Relación 1:N -> Un usuario supervisa muchas piezas
  piezas        Pieza[]
}

model Maquina {
  id_maquina  Int          @id @default(autoincrement())
  nombre      String
  seccion     String

  // Relación 1:N -> Una máquina genera mucha telemetría
  telemetrias Telemetria[]
}

model Pieza {
  id_pieza             String   @id // PK como String (para códigos alfanuméricos/QR)
  id_usuario           Int
  programa_fabricacion Int
  numero_carro         Int
  lote_vidrio_base     String
  lote_pvb             String
  timestamp            DateTime @default(now())

  // Clave foránea
  usuario              Usuario  @relation(fields: [id_usuario], references: [id_usuario])
  
  // Relaciones inversas
  telemetrias          Telemetria[]
  registros_calidad    RegistroCalidad[]
}

model Defecto {
  id_defecto  Int    @id @default(autoincrement())
  nombre      String
  descripcion String

  registros_calidad RegistroCalidad[]
}

model Telemetria {
  id_telemetria               Int      @id @default(autoincrement())
  id_pieza                    String?
  id_maquina                  Int
  timestamp                   DateTime @default(now())
  receta_fabricacion          String
  // Usamos Float para los Decimal del DER (ideal para sensores PLC en Node)
  temp_vidrio_base            Float
  velocidad_lavadora          Float
  temp_agua_lavadora          Float
  temp_entrada_sala_blanca    Float
  temp_ensamblado             Float
  humedad_ensamblado          Float
  presion_calandra_1          Float
  presion_calandra_2          Float
  temp_horno                  Float
  resistencias_encendidas     Int
  temp_salida_horno           Float
  cantidad_polvo_intercalario Float

  // Claves foráneas
  pieza                       Pieza?    @relation(fields: [id_pieza], references: [id_pieza])
  maquina                     Maquina  @relation(fields: [id_maquina], references: [id_maquina])
}

// TABLA INTERMEDIA M:N (Pieza <-> Defecto) con campos propios
model RegistroCalidad {
  id_registro   Int      @id @default(autoincrement())
  id_pieza      String
  id_defecto    Int
  gravedad      String
  observaciones String?  // El interrogante lo hace opcional por si no hay notas

  pieza         Pieza    @relation(fields: [id_pieza], references: [id_pieza])
  defecto       Defecto  @relation(fields: [id_defecto], references: [id_defecto])
}